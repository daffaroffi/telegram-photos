# Normalize line endings: files are authored on Windows (CRLF) but should be
# stored and diffed as LF on GitHub.
* text=auto

*.rs   text eol=lf
*.kt   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.gradle     text eol=lf
*.gradle.kts text eol=lf
*.xml        text eol=lf
*.properties text eol=lf
*.sh   text eol=lf
gradlew text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binaries
*.png  binary
*.ico  binary
*.icns binary
*.jar  binary
*.so   binary
